# Bind to localhost and put the service behind a trusted reverse proxy/VPN.
HOST=127.0.0.1
PORT=3085
WEB_USERNAME=admin
WEB_PASSWORD=replace-with-a-long-random-password

# VideoCMS API base URL must include the /api prefix, e.g. http://videocms:3000/api
VIDEO_CMS_API_BASE_URL=http://127.0.0.1:3000/api
VIDEO_CMS_API_KEY=ak_replace_with_a_VideoCMS_API_key
PARENT_FOLDER_ID=0

# This must refer to the same physical storage root as VideoCMS PublishedQualitysRoot.
MEDIA_ROOT=/data/media/videos
# Keep staging on the same mounted filesystem where possible, to allow atomic renames.
STAGING_ROOT=/data/media/.videocms-importer-staging

# Resource limits
MAX_PARALLEL_JOBS=2
MAX_BATCH_SIZE=500
BROWSER_HEADLESS=true
BROWSER_NO_SANDBOX=false
BROWSER_EXECUTABLE_PATH=
DOWNLOAD_TIMEOUT_MS=3600000
# Maximum FFmpeg container-remux duration (default 30 minutes); no re-encoding is performed.
REMUX_TIMEOUT_MS=1800000
PROVIDER_CAPTURE_WINDOW_MS=12000
FFPROBE_PATH=ffprobe
LOG_DIR=./logs
DB_PATH=./data/importer.sqlite
